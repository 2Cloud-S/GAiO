# Public site origin (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.gaioengine.com

# Sanity / Content Lake
# Create a project at https://www.sanity.io/manage then fill these in.
# Without them the site falls back to sample insights in lib/content.ts.

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional — draft/preview reads
# SANITY_API_READ_TOKEN=

# Required on Vercel (and locally) for likes, views, and comments persistence.
# Create at https://www.sanity.io/manage → Project → API → Tokens
# with Editor (or Contributor with create/update) permissions.
# Never expose this to the browser — server API routes only.
SANITY_API_WRITE_TOKEN=
